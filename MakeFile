.PHONY: help install install-dev scrape curate features train train-lineales tuning compare export-model etl serve docker-build docker-up docker-down docker-logs dvc-repro dvc-push dvc-pull dvc-status format lint typecheck test coverage check clean


# ============================================================
# Variables
# ============================================================

PYTHON := python
PIP := $(PYTHON) -m pip


# ============================================================
# Help
# ============================================================

help:
	@echo "Real Estate Price Prediction"
	@echo ""
	@echo "Available commands:"
	@echo ""
	@echo "  make install       Install production dependencies"
	@echo "  make install-dev   Install development dependencies"
	@echo ""
	@echo "  make scrape        Run the Argenprop scraper (scripts/scrape.py)"
	@echo "  make curate        Run Data Curation (scripts/curate.py)"
	@echo "  make features      Run Feature Engineering (scripts/features.py)"
	@echo "  make train         Run Model Training (scripts/train.py)"
	@echo "  make train-lineales  Run Linear Models Training (scripts/train_lineales.py)"
	@echo "  make tuning         Run XGBoost hyperparameter tuning (scripts/train_tuning.py)"
	@echo "  make compare        Compare MLflow runs and pick champion (scripts/comparar_runs.py)"
	@echo "  make export-model  Export serving bundle (scripts/exportar_modelo.py)"
	@echo "  make etl           Run periodic ETL: scrape + predict + persist (Fase 12)"
	@echo "  make serve         Run FastAPI prediction service (Fase 10)"
	@echo ""
	@echo "  make docker-build  Build Docker image (Fase 11)"
	@echo "  make docker-up     Start the API container (docker compose up -d)"
	@echo "  make docker-down   Stop the API container (docker compose down)"
	@echo "  make docker-logs   Follow the API container logs"
	@echo ""
	@echo "  make dvc-repro     Run DVC data pipeline (dvc repro)"
	@echo "  make dvc-push      Upload data to DVC remote (dvc push)"
	@echo "  make dvc-pull      Download data from DVC remote (dvc pull)"
	@echo "  make dvc-status    Show data pipeline status (dvc status)"
	@echo ""
	@echo "  make format        Format source code with Ruff"
	@echo "  make lint          Run Ruff linter"
	@echo "  make typecheck     Run Mypy type checking"
	@echo "  make test          Run test suite"
	@echo "  make coverage      Run tests with coverage"
	@echo "  make check         Run all quality checks"
	@echo ""
	@echo "  make clean         Remove generated files"
	@echo ""
	@echo "  Extra args:        make scrape ARGS=\"--max-paginas 5\""


# ============================================================
# Installation
# ============================================================

install:
	$(PIP) install .


install-dev:
	$(PIP) install -e ".[dev]"


# ============================================================
# Pipeline
# ============================================================

scrape:
	$(PYTHON) scripts/scrape.py $(ARGS)


curate:
	$(PYTHON) scripts/curate.py $(ARGS)


features:
	$(PYTHON) scripts/features.py $(ARGS)


train:
	$(PYTHON) scripts/train.py $(ARGS)


train-lineales:
	$(PYTHON) scripts/train_lineales.py $(ARGS)


tuning:
	$(PYTHON) scripts/train_tuning.py $(ARGS)


compare:
	$(PYTHON) scripts/comparar_runs.py $(ARGS)


export-model:
	$(PYTHON) scripts/exportar_modelo.py $(ARGS)


etl:
	$(PYTHON) scripts/etl_oportunidades.py $(ARGS)


serve:
	uvicorn real_estate.api.app:app --reload


# ============================================================
# Docker (Fase 11)
# ============================================================

docker-build:
	docker compose build


docker-up:
	docker compose up -d --build


docker-down:
	docker compose down


docker-logs:
	docker compose logs -f


# ============================================================
# DVC (versionado de datos)
# ============================================================

dvc-repro:
	dvc repro


dvc-push:
	dvc push


dvc-pull:
	dvc pull


dvc-status:
	dvc status


# ============================================================
# Code Quality
# ============================================================

format:
	ruff format src tests


lint:
	ruff check src tests


typecheck:
	mypy src tests


# ============================================================
# Testing
# ============================================================

test:
	pytest


coverage:
	pytest --cov=src/real_estate --cov-report=term-missing


# ============================================================
# Quality Gate
# ============================================================

check:
	ruff format --check src tests
	ruff check src tests
	mypy src tests
	pytest


# ============================================================
# Cleanup
# ============================================================

clean:
	$(PYTHON) -c "import shutil; from pathlib import Path; [shutil.rmtree(p, ignore_errors=True) for p in [Path('.pytest_cache'), Path('.mypy_cache'), Path('.ruff_cache'), Path('htmlcov')]]"
